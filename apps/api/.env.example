NODE_ENV=development
PORT=3100
FRONTEND_URL=http://localhost:3000

# "python" en el VPS (servidor real), "mock" sólo en desarrollo local. Es obligatorio.
NFS_PROVIDER=mock
NFS_PYTHON_BIN=python3
NFS_BRIDGE_PATH=/opt/nfs-web/scripts/nfs-web-bridge.py
NFS_SERVER_PATH=/opt/NFS-Online-Server

# Firma de la cookie de sesión. En producción: al menos 32 caracteres aleatorios
# (por ejemplo: openssl rand -hex 32).
SESSION_SECRET=

# Envío de emails (recuperación de contraseña). Sin SMTP_PASS la función queda desactivada.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=contacto@acbldeveloper.com
SMTP_PASS=
MAIL_FROM="NFSU2 Online <contacto@acbldeveloper.com>"
